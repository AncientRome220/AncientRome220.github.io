---
import type { MarkdownHeading } from "astro";

// Layout for Japanese-only notes. Title, description, review date and the
// label of the contents box come from the page's frontmatter.
interface Props {
  frontmatter: { title: string; description: string; reviewed: string; contentsLabel?: string; contentsUnit?: string };
  headings: MarkdownHeading[];
}
const { frontmatter, headings } = Astro.props;
const sections = headings.filter((item) => item.depth === 2);
const canonical = new URL(Astro.url.pathname, Astro.site);
const contentsLabel = frontmatter.contentsLabel ?? "目次";
const contentsUnit = frontmatter.contentsUnit ?? "件";
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={frontmatter.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ja" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={frontmatter.title} />
    <meta property="og:description" content={frontmatter.description} />
    <meta property="og:url" content={canonical} />
    <title>{frontmatter.title} | 藤本俊哉</title>
    <style is:inline>
      :root { color-scheme: light; --ink: #10233f; --rule: #c8cac7; --accent: #804422; }
      * { box-sizing: border-box; }
      body { margin: 0; background: #faf9f5; color: var(--ink); font: 1rem/1.85 "Yu Gothic", Meiryo, sans-serif; }
      main, .masthead { width: min(66rem, 92%); margin: auto; }
      .masthead { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--rule); }
      a { color: #234f67; text-underline-offset: .2em; }
      a:focus-visible, summary:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
      h1, h2 { font-family: "Yu Mincho", "Hiragino Mincho ProN", Georgia, serif; line-height: 1.45; text-wrap: pretty; }
      h1 { max-width: 22em; margin: .45rem 0; font-size: clamp(1.9rem, 5vw, 3.3rem); }
      h2 { border-top: 2px solid var(--ink); padding-top: 1.5rem; margin: 3.5rem 0 .4rem; font-size: clamp(1.35rem, 3vw, 1.95rem); scroll-margin-top: 1rem; }
      main > p { max-width: 46rem; }
      .heading { padding-top: 2rem; }
      .date { color: #4b5360; font-size: .9rem; }
      .contents { margin: 1.5rem 0; padding: .8rem 1rem; border: 1px solid var(--rule); }
      summary { cursor: pointer; font-weight: bold; }
      .contents ul { padding-left: 1.4rem; }
      .contents li { margin: .35em 0; }
      table { width: 100%; margin-top: 1.2rem; border-collapse: collapse; line-break: strict; overflow-wrap: anywhere; }
      th, td { border-top: 1px solid var(--rule); padding: .75rem .65rem; text-align: left; vertical-align: top; }
      th { background: #efeee8; font-size: .85rem; }
      td:first-child { width: 13rem; font-weight: bold; font-size: .95rem; }
      td:nth-child(2) { width: 42%; }
      td { font-size: .95rem; }
      footer { margin: 3rem 0; border-top: 1px solid var(--rule); padding-top: 1rem; }
      @media (max-width: 42rem) {
        table, tbody, tr, td { display: block; }
        thead { position: absolute; clip-path: inset(50%); width: 1px; height: 1px; overflow: hidden; }
        td { border: 0; padding: 0 0 .7rem; }
        td:first-child, td:nth-child(2) { width: auto; }
        td:first-child { padding: .7rem 0 .15rem; border-top: 1px solid var(--rule); font-size: 1rem; }
      }
      @media print { .masthead, .contents, footer { display: none; } tr, h2 { break-inside: avoid; } h2 { break-after: avoid; } }
    </style>
  </head>
  <body>
    <header class="masthead">
      <a href="/activities/">藤本俊哉　研究活動</a>
    </header>
    <main>
      <header class="heading">
        <h1>{frontmatter.title}</h1>
        <p class="date">資料確認日　<time datetime={frontmatter.reviewed}>{frontmatter.reviewed}</time></p>
      </header>
      <details class="contents" id="contents">
        <summary>{contentsLabel}（{sections.length}{contentsUnit}）</summary>
        <nav aria-label={contentsLabel}><ul>
          {sections.map((item) => <li><a href={`#${item.slug}`}>{item.text}</a></li>)}
        </ul></nav>
      </details>
      <slot />
      <footer><a href="#contents">目次へ戻る</a></footer>
    </main>
  </body>
</html>
