---
import BaseLayout from "../layouts/BaseLayout.astro";
import CvPage from "./CvPage.astro";
import { messages, pageRoutes, type Locale, type PageKey } from "../lib/i18n";
import { linksFor, list, period, presentationLabel, profile, publicationDetails, publicationNote, publicationTypeLabel, t } from "../lib/data";

interface Props { locale: Locale; page: PageKey }
const { locale, page } = Astro.props;
const msg = messages[locale];
const name = t(profile.identity.name, locale);
const affiliation = [
  t(profile.current_affiliation.organization, locale),
  t(profile.current_affiliation.section, locale),
  t(profile.current_affiliation.position, locale)
].filter(Boolean).join(" · ");
const publications = [...profile.publications].sort((a, b) => b.date.localeCompare(a.date));
const presentations = [...profile.presentations].sort((a, b) => b.date.localeCompare(a.date));
const outreach = [...profile.social_contributions].sort((a, b) => (b.date || b.from || "").localeCompare(a.date || a.from || ""));
const contactEmail = profile.public_contact.email;
const externalProfiles = [
  ["ORCID", profile.identity.public_identifiers.orcid_url],
  ["researchmap", profile.identity.public_identifiers.researchmap_url],
  ["J-GLOBAL", profile.identity.public_identifiers.j_global_url],
  ["GitHub", profile.identity.public_identifiers.github_url]
];
const pageTitle = msg.titles[page];
---

<BaseLayout {locale} {page}>
  {page === "home" && (
    <>
      <section class="hero ruled-section">
        <p class="eyebrow">{locale === "ja" ? "Researcher Profile" : "Researcher Profile"}</p>
        <h1>{name}</h1>
        <p class="name-secondary" lang={locale === "ja" ? "en" : "ja"}>{locale === "ja" ? profile.identity.name.en : profile.identity.name.ja}</p>
        <p class="affiliation">{affiliation}</p>
        <p class="lead">{profile.profile[locale].summary}</p>
        <div class="hero-actions">
          <a class="button" href={pageRoutes[locale].research}>{msg.nav.research}</a>
          <a class="text-link" href={pageRoutes[locale].publications}>{msg.nav.publications} →</a>
        </div>
      </section>

      <section class="section-grid ruled-section" aria-labelledby="projects-title">
        <div><p class="section-number">01</p><h2 id="projects-title">{msg.currentProjects}</h2></div>
        <ol class="project-list">
          {profile.profile[locale].current_projects.map((project: string) => <li>{project}</li>)}
        </ol>
      </section>

      <section class="section-grid ruled-section" aria-labelledby="keywords-title">
        <div><p class="section-number">02</p><h2 id="keywords-title">{msg.interests}</h2></div>
        <ul class="tag-list">{profile.research_interests.map((item: any) => <li>{t(item, locale)}</li>)}</ul>
      </section>

      <section class="section-grid ruled-section" aria-labelledby="profiles-title">
        <div><p class="section-number">03</p><h2 id="profiles-title">{msg.external}</h2></div>
        <ul class="external-list">
          <li><a href={`mailto:${contactEmail}`}>{contactEmail}<span aria-hidden="true"> ✉</span></a></li>
          {externalProfiles.map(([label, url]) => <li><a href={url} rel="me noreferrer">{label}<span aria-hidden="true"> ↗</span></a></li>)}
        </ul>
      </section>
    </>
  )}

  {page === "research" && (
    <>
      <header class="page-heading ruled-section"><p class="eyebrow">Research</p><h1>{pageTitle}</h1><p class="lead">{profile.profile[locale].summary}</p></header>
      <section class="section-grid ruled-section" aria-labelledby="current-projects">
        <div><p class="section-number">01</p><h2 id="current-projects">{msg.currentProjects}</h2></div>
        <ol class="project-list">{profile.profile[locale].current_projects.map((project: string) => <li>{project}</li>)}</ol>
      </section>
      <section class="section-grid ruled-section" aria-labelledby="research-areas">
        <div><p class="section-number">02</p><h2 id="research-areas">{msg.areas}</h2></div>
        <div class="record-list">{profile.research_areas.map((area: any) => <article><h3>{t(area.keyword, locale)}</h3><p>{t(area.discipline, locale)} · {t(area.field, locale)}</p></article>)}</div>
      </section>
      <section class="section-grid ruled-section" aria-labelledby="research-keywords">
        <div><p class="section-number">03</p><h2 id="research-keywords">{msg.interests}</h2></div>
        <ul class="tag-list">{profile.research_interests.map((item: any) => <li>{t(item, locale)}</li>)}</ul>
      </section>
    </>
  )}

  {page === "publications" && (
    <>
      <header class="page-heading ruled-section"><p class="eyebrow">Publications</p><h1>{pageTitle}</h1><p><a class="button button-small" href="/downloads/publications.bib" download>{msg.downloadBib}</a></p></header>
      <section class="publication-section ruled-section" aria-labelledby="publication-list-title">
        <h2 id="publication-list-title" class="visually-hidden">{msg.publications}</h2>
        <ol class="publication-list">
          {publications.map((item: any) => (
            <li>
              <article>
                <div class="record-date"><time datetime={item.date}>{item.date}</time></div>
                <div>
                  <p class="record-type">{publicationTypeLabel(item.category, locale)}{item.peer_reviewed ? ` · ${msg.peerReviewed}` : ""}</p>
                  <h3>{t(item.title, locale)}</h3>
                  <p>{list(item.authors, locale).join(locale === "ja" ? "、" : ", ")}</p>
                  <p class="citation-detail">{publicationDetails(item, locale)}</p>
                  {publicationNote(item, locale) && <p class="citation-detail" data-publication-note>{publicationNote(item, locale)}.</p>}
                  {(item.doi || item.url) && <p class="record-links">
                    {item.doi && <a href={`https://doi.org/${item.doi}`}>{msg.doi}: {item.doi}<span aria-hidden="true"> ↗</span></a>}
                    {item.url && (!item.doi || item.url !== `https://doi.org/${item.doi}`) && <a href={item.url}>{msg.repository}<span aria-hidden="true"> ↗</span></a>}
                  </p>}
                </div>
              </article>
            </li>
          ))}
        </ol>
      </section>
    </>
  )}

  {page === "activities" && (
    <>
      <header class="page-heading ruled-section"><p class="eyebrow">Activities</p><h1>{pageTitle}</h1></header>
      <section class="section-grid ruled-section" aria-labelledby="presentations-title">
        <div><p class="section-number">01</p><h2 id="presentations-title">{msg.presentations}</h2></div>
        <ol class="record-list dated-records">
          {presentations.map((item: any) => {
            const related = linksFor(`Presentation, ${item.date}`);
            return <li><article data-presentation-status={item.status}><time datetime={item.date}>{item.date}</time><p class="record-type">{presentationLabel(item, locale)}</p><h3>{t(item.title, locale)}</h3><p>{t(item.event, locale)}{t(item.location, locale) && ` · ${t(item.location, locale)}`}</p>{list(item.co_presenters, locale).length > 0 && <p>{locale === "ja" ? "共同発表者" : "Co-presenters"}: {list(item.co_presenters, locale).join(locale === "ja" ? "、" : ", ")}</p>}{related.length > 0 && <p class="record-links">{related.map((file) => <a href={file.url}>{msg.materials}: {file.source_name}<span aria-hidden="true"> ↗</span></a>)}</p>}</article></li>;
          })}
        </ol>
      </section>
      <section class="section-grid ruled-section" aria-labelledby="outreach-title">
        <div><p class="section-number">02</p><h2 id="outreach-title">{msg.outreach}</h2></div>
        <ol class="record-list dated-records">
          {outreach.map((item: any) => {
            const related = linksFor(`Social contribution, ${item.date || item.from}`);
            return <li><article><time datetime={item.date || item.from}>{period(item, locale)}</time><h3>{t(item.title, locale)}</h3><p>{t(item.event, locale)}{t(item.location, locale) && ` · ${t(item.location, locale)}`}</p>{related.length > 0 && <p class="record-links">{related.map((file) => <a href={file.url}>{msg.materials}: {file.source_name}<span aria-hidden="true"> ↗</span></a>)}</p>}</article></li>;
          })}
        </ol>
      </section>
    </>
  )}

  {page === "cv" && (
    <CvPage {locale} />
  )}
</BaseLayout>
